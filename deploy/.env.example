# ==========================================
# 来客兄弟 - 生产环境配置
# 复制此文件为 .env 并修改
# ==========================================

# 服务端口（确保不与其它项目冲突）
PORT=3002

# 管理后台 Token（请改为复杂随机字符串）
ADMIN_TOKEN=admin-key-2026

# ---- 通知渠道（可选）----

# Webhook 通知
# WEBHOOK_URL=https://your-webhook-url.com/api/notify

# 企业微信机器人
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 邮件通知（需先 npm install nodemailer）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=notify@example.com
# SMTP_PASS=your-password
# NOTIFY_EMAIL=admin@laikedixiong.com

# ---- 支付（微信支付商户号申请中）----
# 以下配置齐全后自动启用微信扫码支付（Native）；未配置时使用「收款码 + 人工确认」模式
# WXPAY_APPID=wx1234567890abcdef        # 微信 AppID
# WXPAY_MCHID=1900000001               # 商户号
# WXPAY_SERIAL=1234567890ABCDEF        # 商户 API 证书序列号
# WXPAY_APIV3KEY=32位随机字符串         # APIv3 密钥
# WXPAY_PRIVATE_KEY_PATH=/opt/laikedixiong-site/server/certs/apiclient_key.pem
# WXPAY_PLATFORM_CERT_PATH=/opt/laikedixiong-site/server/certs/wechatpay_platform.pem
# WXPAY_NOTIFY_URL=https://lkxdai.com/api/pay/notify

# 收款码图片（收款码模式展示；把收款码图片上传到 /uploads/pay-qrcode.png 即可）
# PAY_QRCODE_IMG=/uploads/pay-qrcode.png

# ---- 提示词攻防游戏（AI攻防擂台）----
# 未配置时游戏显示「暂未开放」
DEEPSEEK_API_KEY=
# MOCK_LLM=1   # 仅本地开发：无 key 时模拟守密AI回复（用于测试游戏流程）
